# ============================================================
# VELoop CAPTCHA Earn — ROOT .env.example (PLACEHOLDERS ONLY)
# ============================================================
# This root .env.example exists ONLY as a human-readable reference
# for the full environment surface across both packages.
#
# ACTUAL runtime environment files live in:
#   backend/.env     — all backend secrets + flags
#   frontend/.env    — only public VITE_ prefixed vars
#
# NEVER PUT REAL SECRETS HERE.
# ============================================================

# ---------- BACKEND ----------
# Copy these keys into backend/.env and fill real values.

# Port that the Express server listens on
PORT=5000

# MongoDB connection string (local or Atlas srv)
# Example local:    mongodb://127.0.0.1:27017/veloop_captcha
# Example Atlas:    mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/veloop_captcha?retryWrites=true&w=majority
MONGO_URI=

# Long random string used to sign JWT access tokens.
# Generate via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Challenge TTL in seconds. After this, ACTIVE challenges auto-expire.
CAPTCHA_EXPIRY_SECONDS=60

# Public origin of the deployed frontend (protocol + host, NO trailing slash).
# CRITICAL in production: backend hard-exits startup if NODE_ENV=production and this is unset.
# Used by strict CORS allow-list.
FRONTEND_URL=http://localhost:5173

# development | production
NODE_ENV=development


# ---------- FRONTEND ----------
# Copy into frontend/.env. VITE_ prefix is REQUIRED for Vite to bundle.

# Public API base URL for frontend fetch calls.
# Dev:   http://localhost:5000/api
# Prod:  https://your-deployed-backend.example.com/api
VITE_API_BASE_URL=http://localhost:5000/api
