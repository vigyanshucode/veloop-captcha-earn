node_modules/
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Explicit per-package nested env files (defense-in-depth: recursive gitignore may be ambiguous)
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Catch-all for any deep-nested env secrets (still allow .env.example placeholders)
**/.env
**/.env.*
!**/.env.example

